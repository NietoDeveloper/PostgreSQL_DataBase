# Bootstrap/owner role — used ONLY to run migrations (docker-entrypoint
# makes this a superuser). Never point the application at this role.
POSTGRES_USER=db_owner
# Generate a strong, random value — do NOT reuse this example.
#   e.g. openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=functional_db
POSTGRES_PORT=5432

# Bootstrap connection string, for running migrations / scripts/init.sh
# and scripts/create_app_role.sh (owner role, local/CI use only).
DATABASE_URL=postgresql://db_owner:CHANGE_ME@localhost:5432/functional_db

# Least-privilege LOGIN role the application actually connects as.
# Created by scripts/create_app_role.sh — generate a separate strong
# password for this one too (never reuse POSTGRES_PASSWORD).
APP_DB_PASSWORD=

# In any environment beyond local dev, also set sslmode=require (or
# verify-full with a CA bundle) on every connection string above.
